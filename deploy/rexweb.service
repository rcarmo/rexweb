[Unit]
Description=Rexweb terminal service
After=network.target

[Service]
Type=simple
User=rexweb
Group=rexweb
RuntimeDirectory=rexweb
RuntimeDirectoryMode=0700
StateDirectory=rexweb rexweb-work
StateDirectoryMode=0700
WorkingDirectory=/var/lib/rexweb
ExecStart=/usr/local/bin/rexweb -mode both -session-socket /run/rexweb/session.sock -workspace /var/lib/rexweb-work
Restart=on-failure
RestartSec=5
TimeoutStopSec=10
KillMode=control-group
UMask=0077
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
# User/mount/PID/network namespaces are required by the default shell sandbox.
# Do not add PrivateUsers=yes or RestrictNamespaces=yes.

[Install]
WantedBy=multi-user.target
